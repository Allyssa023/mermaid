# Marine Service Configuration
# Copy this file to .env and fill in values

# Server
PORT=8081

# Security — shared secret between Java backend and this service
# Generate a strong random value for production (e.g., openssl rand -hex 32)
MARINE_API_KEY=dev-marine-key-change-in-prod

# CORS — space-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173 http://localhost:8080

# Cache TTL (seconds)
CONDITIONS_CACHE_TTL=900   # 15 minutes
FORECAST_CACHE_TTL=3600    # 1 hour

# HTTP client
HTTP_TIMEOUT=10.0

# ══════════════════════════════════════════════════════════
#  MERMAID — Docker Environment Variables
#  Copy this file to .env at the project root:
#    cp .env.docker .env
#  Then customize values as needed.
# ══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=mermaid_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
DB_PORT=5432

# ── Backend (Spring Boot) ─────────────────────────────────
JWT_SECRET=your-256-bit-secret-change-in-production-use-env-var
JWT_ISSUER=mermaid-api
JWT_EXPIRY_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ── Marine Service (Django) ───────────────────────────────
MARINE_API_KEY=dev-marine-key-change-in-prod
DJANGO_SECRET_KEY=docker-secret-change-in-prod
DJANGO_DEBUG=False

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=5173
